# Copy to .env (gitignored) and fill in.

# The benkyou Agent API base — see ../docs/AGENT_API.md. This is your
# Netlify site origin plus /.netlify/functions.
BENKYOU_API_URL=https://your-benkyou-site.netlify.app/.netlify/functions
BENKYOU_AGENT_TOKEN=

# Your local-network LLM's OpenAI-compatible chat endpoint, e.g. Ollama
# (http://<lan-ip>:11434/v1) or LM Studio (http://<lan-ip>:1234/v1).
# This server must be able to reach that address, so run it on the same
# machine or the same LAN as the LLM.
LLM_BASE_URL=http://192.168.1.50:11434/v1
LLM_MODEL=llama3.1
LLM_API_KEY=

# Port this server listens on. Bind is 0.0.0.0 so other devices on your
# LAN (e.g. a Pixelbook) can reach it at http://<this-machine-lan-ip>:PORT.
PORT=3001
